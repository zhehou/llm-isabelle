{"id":"deep_take_map_nested","category":"lists","difficulty":"hard","required_mechanism":"nested_case_outer_ih","baseline":"structured","dependency_depth":3,"goal":"take n (map f xs) = map f (take n xs)","outline":"lemma \"take n (map f xs) = map f (take n xs)\"\nproof (induction xs arbitrary: n)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  show ?case\n  proof (cases n)\n    case 0\n    then show ?thesis\n      sorry\n  next\n    case (Suc m)\n    then show ?thesis\n      using Cons.IH\n      sorry\n  qed\nqed"}
{"id":"deep_take_drop_map_chain","category":"lists","difficulty":"hard","required_mechanism":"dependent_fact_chain","baseline":"structured","dependency_depth":2,"goal":"take n (map f xs) @ drop n (map f xs) = map f xs","outline":"lemma \"take n (map f xs) @ drop n (map f xs) = map f xs\"\nproof -\n  have take_map: \"take n (map f xs) = map f (take n xs)\"\n    sorry\n  have drop_map: \"drop n (map f xs) = map f (drop n xs)\"\n    sorry\n  have split: \"take n xs @ drop n xs = xs\"\n    sorry\n  show ?thesis\n    using take_map drop_map split\n    sorry\nqed"}
{"id":"deep_rev_map_append","category":"lists","difficulty":"hard","required_mechanism":"calculation_chain","baseline":"structured","dependency_depth":2,"goal":"rev (map f (xs @ ys)) = map f (rev ys) @ map f (rev xs)","outline":"lemma \"rev (map f (xs @ ys)) = map f (rev ys) @ map f (rev xs)\"\nproof -\n  have mapped: \"map f (xs @ ys) = map f xs @ map f ys\"\n    sorry\n  have reversed: \"rev (map f xs @ map f ys) = rev (map f ys) @ rev (map f xs)\"\n    sorry\n  have left: \"rev (map f xs) = map f (rev xs)\"\n    sorry\n  have right: \"rev (map f ys) = map f (rev ys)\"\n    sorry\n  show ?thesis\n    using mapped reversed left right\n    sorry\nqed"}
{"id":"deep_filter_map_invariant","category":"lists","difficulty":"hard","required_mechanism":"induction_case_premise","baseline":"structured","dependency_depth":3,"goal":"(⋀x. p (f x) = p x) ⟹ map f (filter p xs) = filter p (map f xs)","outline":"lemma \"(⋀x. p (f x) = p x) ⟹ map f (filter p xs) = filter p (map f xs)\"\nproof -\n  assume preserve: \"⋀x. p (f x) = p x\"\n  show \"map f (filter p xs) = filter p (map f xs)\"\n  proof (induction xs)\n    case Nil\n    show ?case\n      sorry\n  next\n    case (Cons a xs)\n    show ?case\n    proof (cases \"p a\")\n      case True\n      have image_true: \"p (f a)\"\n        using preserve True\n        sorry\n      then show ?thesis\n        using Cons.IH True\n        sorry\n    next\n      case False\n      have image_false: \"¬ p (f a)\"\n        using preserve False\n        sorry\n      then show ?thesis\n        using Cons.IH False\n        sorry\n    qed\n  qed\nqed"}
{"id":"deep_distinct_injective_map","category":"lists","difficulty":"hard","required_mechanism":"induction_premise_elimination","baseline":"theorem_search","dependency_depth":2,"goal":"inj f ⟹ distinct xs ⟹ distinct (map f xs)","outline":"lemma \"inj f ⟹ distinct xs ⟹ distinct (map f xs)\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  have tail: \"distinct (map f xs)\"\n    using Cons.IH Cons.prems\n    sorry\n  have fresh: \"f a ∉ set (map f xs)\"\n    using Cons.prems\n    sorry\n  show ?case\n    using tail fresh\n    sorry\nqed"}
{"id":"deep_length_filter_bound","category":"lists","difficulty":"medium","required_mechanism":"induction_boolean_cases","baseline":"structured","dependency_depth":3,"goal":"length (filter p xs) ≤ length xs","outline":"lemma \"length (filter p xs) ≤ length xs\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  show ?case\n  proof (cases \"p a\")\n    case True\n    then show ?thesis\n      using Cons.IH\n      sorry\n  next\n    case False\n    then show ?thesis\n      using Cons.IH\n      sorry\n  qed\nqed"}
{"id":"deep_image_union","category":"sets","difficulty":"hard","required_mechanism":"branch_fact_replay","baseline":"structured","dependency_depth":3,"goal":"A ⊆ B ⟹ f ` A ∪ f ` C ⊆ f ` (B ∪ C)","outline":"lemma \"A ⊆ B ⟹ f ` A ∪ f ` C ⊆ f ` (B ∪ C)\"\nproof -\n  assume sub: \"A ⊆ B\"\n  show \"f ` A ∪ f ` C ⊆ f ` (B ∪ C)\"\n  proof (rule subsetI)\n    fix y\n    assume member: \"y ∈ f ` A ∪ f ` C\"\n    show \"y ∈ f ` (B ∪ C)\"\n    proof (cases \"y ∈ f ` A\")\n      case True\n      then show ?thesis\n        using sub\n        sorry\n    next\n      case False\n      then show ?thesis\n        using member\n        sorry\n    qed\n  qed\nqed"}
{"id":"deep_image_intersection","category":"sets","difficulty":"hard","required_mechanism":"witness_and_injectivity","baseline":"theorem_search","dependency_depth":3,"goal":"inj f ⟹ f ` (A ∩ B) = f ` A ∩ f ` B","outline":"lemma \"inj f ⟹ f ` (A ∩ B) = f ` A ∩ f ` B\"\nproof -\n  assume inj: \"inj f\"\n  show \"f ` (A ∩ B) = f ` A ∩ f ` B\"\n  proof (rule equalityI)\n    show \"f ` (A ∩ B) ⊆ f ` A ∩ f ` B\"\n      sorry\n  next\n    show \"f ` A ∩ f ` B ⊆ f ` (A ∩ B)\"\n    proof\n      fix y\n      assume member: \"y ∈ f ` A ∩ f ` B\"\n      then obtain a b where a: \"a ∈ A\" \"y = f a\" and b: \"b ∈ B\" \"y = f b\"\n        sorry\n      have eq: \"a = b\"\n        using inj a b\n        sorry\n      show \"y ∈ f ` (A ∩ B)\"\n        using a b eq\n        sorry\n    qed\n  qed\nqed"}
{"id":"deep_surj_image_preimage","category":"sets","difficulty":"medium","required_mechanism":"witness_construction","baseline":"structured","dependency_depth":3,"goal":"surj f ⟹ f ` (f -` A) = A","outline":"lemma \"surj f ⟹ f ` (f -` A) = A\"\nproof -\n  assume surj: \"surj f\"\n  show \"f ` (f -` A) = A\"\n  proof (rule equalityI)\n    show \"f ` (f -` A) ⊆ A\"\n      sorry\n  next\n    show \"A ⊆ f ` (f -` A)\"\n    proof\n      fix y\n      assume yA: \"y ∈ A\"\n      obtain x where fx: \"f x = y\"\n        using surj\n        sorry\n      show \"y ∈ f ` (f -` A)\"\n        using yA fx\n        sorry\n    qed\n  qed\nqed"}
{"id":"deep_inj_preimage_image","category":"sets","difficulty":"medium","required_mechanism":"witness_and_injectivity","baseline":"structured","dependency_depth":3,"goal":"inj f ⟹ f -` (f ` A) = A","outline":"lemma \"inj f ⟹ f -` (f ` A) = A\"\nproof -\n  assume inj: \"inj f\"\n  show \"f -` (f ` A) = A\"\n  proof (rule equalityI)\n    show \"f -` (f ` A) ⊆ A\"\n    proof\n      fix x\n      assume member: \"x ∈ f -` (f ` A)\"\n      then obtain a where aA: \"a ∈ A\" and eq: \"f x = f a\"\n        sorry\n      have \"x = a\"\n        using inj eq\n        sorry\n      then show \"x ∈ A\"\n        using aA\n        sorry\n    qed\n  next\n    show \"A ⊆ f -` (f ` A)\"\n      sorry\n  qed\nqed"}
{"id":"deep_nat_mult_mono","category":"arithmetic","difficulty":"medium","required_mechanism":"transitive_fact_chain","baseline":"structured","dependency_depth":2,"goal":"(a::nat) ≤ b ⟹ c ≤ d ⟹ a * c ≤ b * d","outline":"lemma \"(a::nat) ≤ b ⟹ c ≤ d ⟹ a * c ≤ b * d\"\nproof -\n  assume ab: \"a ≤ b\"\n  assume cd: \"c ≤ d\"\n  have left: \"a * c ≤ b * c\"\n    using ab\n    sorry\n  have right: \"b * c ≤ b * d\"\n    using cd\n    sorry\n  show \"a * c ≤ b * d\"\n    using left right\n    sorry\nqed"}
{"id":"deep_sum_map_offset","category":"arithmetic","difficulty":"hard","required_mechanism":"induction_calculation","baseline":"structured","dependency_depth":2,"goal":"sum_list (map (λx. x + k) xs) = sum_list xs + length xs * k","outline":"lemma \"sum_list (map (λx. x + k) xs) = sum_list xs + length xs * k\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  have tail: \"sum_list (map (λx. x + k) xs) = sum_list xs + length xs * k\"\n    using Cons.IH\n    sorry\n  show ?case\n    using tail\n    sorry\nqed"}
{"id":"deep_replicate_append","category":"arithmetic","difficulty":"medium","required_mechanism":"induction_generalization","baseline":"structured","dependency_depth":2,"goal":"replicate (m + n) x = replicate m x @ replicate n x","outline":"lemma \"replicate (m + n) x = replicate m x @ replicate n x\"\nproof (induction m)\n  case 0\n  show ?case\n    sorry\nnext\n  case (Suc m)\n  have tail: \"replicate (m + n) x = replicate m x @ replicate n x\"\n    using Suc.IH\n    sorry\n  show ?case\n    using tail\n    sorry\nqed"}
{"id":"deep_quantifier_witness","category":"logic","difficulty":"hard","required_mechanism":"multi_witness_transport","baseline":"structured","dependency_depth":2,"goal":"(∀x. P x ⟶ (∃y. R x y)) ⟹ (∃x. P x) ⟹ ∃x y. R x y","outline":"lemma \"(∀x. P x ⟶ (∃y. R x y)) ⟹ (∃x. P x) ⟹ ∃x y. R x y\"\nproof -\n  assume step: \"∀x. P x ⟶ (∃y. R x y)\"\n  assume exists: \"∃x. P x\"\n  obtain x where px: \"P x\"\n    using exists\n    sorry\n  obtain y where rxy: \"R x y\"\n    using step px\n    sorry\n  show \"∃x y. R x y\"\n    using rxy\n    sorry\nqed"}
{"id":"deep_quantifier_chain","category":"logic","difficulty":"medium","required_mechanism":"dependent_fact_chain","baseline":"structured","dependency_depth":3,"goal":"(∀x. P x ⟶ Q x) ⟹ (∀x. Q x ⟶ R x) ⟹ ∀x. P x ⟶ R x","outline":"lemma \"(∀x. P x ⟶ Q x) ⟹ (∀x. Q x ⟶ R x) ⟹ ∀x. P x ⟶ R x\"\nproof -\n  assume pq: \"∀x. P x ⟶ Q x\"\n  assume qr: \"∀x. Q x ⟶ R x\"\n  show \"∀x. P x ⟶ R x\"\n  proof\n    fix x\n    show \"P x ⟶ R x\"\n    proof\n      assume px: \"P x\"\n      have qx: \"Q x\"\n        using pq px\n        sorry\n      show \"R x\"\n        using qr qx\n        sorry\n    qed\n  qed\nqed"}
{"id":"deep_relation_chain","category":"relations","difficulty":"medium","required_mechanism":"named_rule_chain","baseline":"theorem_search","dependency_depth":2,"goal":"trans r ⟹ (a,b) ∈ r ⟹ (b,c) ∈ r ⟹ (c,d) ∈ r ⟹ (a,d) ∈ r","outline":"lemma \"trans r ⟹ (a,b) ∈ r ⟹ (b,c) ∈ r ⟹ (c,d) ∈ r ⟹ (a,d) ∈ r\"\nproof -\n  assume tr: \"trans r\"\n  assume ab: \"(a,b) ∈ r\"\n  assume bc: \"(b,c) ∈ r\"\n  assume cd: \"(c,d) ∈ r\"\n  have ac: \"(a,c) ∈ r\"\n    using tr ab bc\n    sorry\n  show \"(a,d) ∈ r\"\n    using tr ac cd\n    sorry\nqed"}
{"id":"deep_option_map_comp","category":"datatypes","difficulty":"medium","required_mechanism":"datatype_cases","baseline":"structured","dependency_depth":2,"goal":"map_option f (map_option g x) = map_option (f ∘ g) x","outline":"lemma \"map_option f (map_option g x) = map_option (f ∘ g) x\"\nproof (cases x)\n  case None\n  show ?thesis\n    using None\n    sorry\nnext\n  case (Some a)\n  show ?thesis\n    using Some\n    sorry\nqed"}
{"id":"deep_function_extensionality","category":"functions","difficulty":"medium","required_mechanism":"extensionality_chain","baseline":"structured","dependency_depth":2,"goal":"(⋀x. f x = g x) ⟹ (λx. h (f x)) = (λx. h (g x))","outline":"lemma \"(⋀x. f x = g x) ⟹ (λx. h (f x)) = (λx. h (g x))\"\nproof -\n  assume pointwise: \"⋀x. f x = g x\"\n  show \"(λx. h (f x)) = (λx. h (g x))\"\n  proof (rule ext)\n    fix x\n    have eq: \"f x = g x\"\n      using pointwise\n      sorry\n    show \"h (f x) = h (g x)\"\n      using eq\n      sorry\n  qed\nqed"}
