# fixture_expect: holes
{"id":"nested_map_append","category":"induction_multihole","goal":"map g (map f (xs @ ys)) = map (g ∘ f) xs @ map (g ∘ f) ys","outline":"lemma \"map g (map f (xs @ ys)) = map (g ∘ f) xs @ map (g ∘ f) ys\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  have step1: \"map f ((a # xs) @ ys) = f a # map f (xs @ ys)\"\n    sorry\n  have step2: \"map g (map f (xs @ ys)) = map (g ∘ f) xs @ map (g ∘ f) ys\"\n    using Cons.IH\n    sorry\n  show ?case\n    using step1 step2\n    sorry\nqed"}
{"id":"reverse_concat","category":"induction_rewrite","goal":"rev (concat xss) = concat (map rev (rev xss))","outline":"lemma \"rev (concat xss) = concat (map rev (rev xss))\"\nproof (induction xss)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons xs xss)\n  have ih: \"rev (concat xss) = concat (map rev (rev xss))\"\n    using Cons.IH\n    sorry\n  show ?case\n    using ih\n    sorry\nqed"}
{"id":"length_concat","category":"induction_calculation","goal":"length (concat xss) = sum_list (map length xss)","outline":"lemma \"length (concat xss) = sum_list (map length xss)\"\nproof (induction xss)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons xs xss)\n  have tail: \"length (concat xss) = sum_list (map length xss)\"\n    using Cons.IH\n    sorry\n  show ?case\n    using tail\n    sorry\nqed"}
{"id":"filter_intersection","category":"induction_cases","goal":"filter p (filter q xs) = filter (λx. p x ∧ q x) xs","outline":"lemma \"filter p (filter q xs) = filter (λx. p x ∧ q x) xs\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  show ?case\n  proof (cases \"q a\")\n    case True\n    then show ?thesis\n      using Cons.IH\n      sorry\n  next\n    case False\n    then show ?thesis\n      using Cons.IH\n      sorry\n  qed\nqed"}
{"id":"take_map","category":"nested_cases","goal":"take n (map f xs) = map f (take n xs)","outline":"lemma \"take n (map f xs) = map f (take n xs)\"\nproof (induction xs arbitrary: n)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  show ?case\n  proof (cases n)\n    case 0\n    then show ?thesis\n      sorry\n  next\n    case (Suc m)\n    then show ?thesis\n      using Cons.IH\n      sorry\n  qed\nqed"}
{"id":"drop_map","category":"nested_cases","goal":"drop n (map f xs) = map f (drop n xs)","outline":"lemma \"drop n (map f xs) = map f (drop n xs)\"\nproof (induction xs arbitrary: n)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  show ?case\n  proof (cases n)\n    case 0\n    then show ?thesis\n      sorry\n  next\n    case (Suc m)\n    then show ?thesis\n      using Cons.IH\n      sorry\n  qed\nqed"}
{"id":"list_all_append","category":"induction_iff","goal":"list_all p (xs @ ys) ⟷ list_all p xs ∧ list_all p ys","outline":"lemma \"list_all p (xs @ ys) ⟷ list_all p xs ∧ list_all p ys\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  have tail: \"list_all p (xs @ ys) ⟷ list_all p xs ∧ list_all p ys\"\n    using Cons.IH\n    sorry\n  show ?case\n    using tail\n    sorry\nqed"}
{"id":"sum_replicate","category":"arithmetic_induction","goal":"sum_list (replicate n k) = n * k","outline":"lemma \"sum_list (replicate n k) = n * k\"\nproof (induction n)\n  case 0\n  show ?case\n    sorry\nnext\n  case (Suc n)\n  have tail: \"sum_list (replicate n k) = n * k\"\n    using Suc.IH\n    sorry\n  show ?case\n    using tail\n    sorry\nqed"}
{"id":"set_filter","category":"set_extensionality","goal":"set (filter p xs) = {x ∈ set xs. p x}","outline":"lemma \"set (filter p xs) = {x ∈ set xs. p x}\"\nproof (rule set_eqI)\n  fix x\n  show \"x ∈ set (filter p xs) ⟷ x ∈ {x ∈ set xs. p x}\"\n  proof\n    assume left: \"x ∈ set (filter p xs)\"\n    then show \"x ∈ {x ∈ set xs. p x}\"\n      sorry\n  next\n    assume right: \"x ∈ {x ∈ set xs. p x}\"\n    then show \"x ∈ set (filter p xs)\"\n      sorry\n  qed\nqed"}
{"id":"distinct_injective_map","category":"induction_premises","goal":"inj f ⟹ distinct xs ⟹ distinct (map f xs)","outline":"lemma \"inj f ⟹ distinct xs ⟹ distinct (map f xs)\"\nproof (induction xs)\n  case Nil\n  show ?case\n    sorry\nnext\n  case (Cons a xs)\n  have tail: \"distinct (map f xs)\"\n    using Cons.IH Cons.prems\n    sorry\n  have fresh: \"f a ∉ set (map f xs)\"\n    using Cons.prems\n    sorry\n  show ?case\n    using tail fresh\n    sorry\nqed"}
{"id":"quantifier_chain","category":"quantifier_multistep","goal":"(∀x. P x ⟶ Q x) ⟹ (∀x. Q x ⟶ R x) ⟹ ∀x. P x ⟶ R x","outline":"lemma \"(∀x. P x ⟶ Q x) ⟹ (∀x. Q x ⟶ R x) ⟹ ∀x. P x ⟶ R x\"\nproof -\n  assume pq: \"∀x. P x ⟶ Q x\"\n  assume qr: \"∀x. Q x ⟶ R x\"\n  show \"∀x. P x ⟶ R x\"\n  proof\n    fix x\n    show \"P x ⟶ R x\"\n    proof\n      assume px: \"P x\"\n      have qx: \"Q x\"\n        using pq px\n        sorry\n      show \"R x\"\n        using qr qx\n        sorry\n    qed\n  qed\nqed"}
{"id":"image_union_chain","category":"set_multihole","goal":"A ⊆ B ⟹ f ` A ∪ f ` C ⊆ f ` (B ∪ C)","outline":"lemma \"A ⊆ B ⟹ f ` A ∪ f ` C ⊆ f ` (B ∪ C)\"\nproof -\n  assume sub: \"A ⊆ B\"\n  show \"f ` A ∪ f ` C ⊆ f ` (B ∪ C)\"\n  proof (rule subsetI)\n    fix y\n    assume member: \"y ∈ f ` A ∪ f ` C\"\n    show \"y ∈ f ` (B ∪ C)\"\n    proof (cases \"y ∈ f ` A\")\n      case True\n      then show ?thesis\n        using sub\n        sorry\n    next\n      case False\n      then show ?thesis\n        using member\n        sorry\n    qed\n  qed\nqed"}
