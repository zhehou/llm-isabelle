# Novel-theory planner benchmark. Run with --problem-fixtures, not --outline-fixtures.
# Every problem declares fresh constants, so exact Main theorem replay cannot solve it by name.
{"id":"novel_01_rev_acc","goal":"nvr_acc xs acc = rev xs @ acc","preamble":"fun nvr_acc :: \"'a list ⇒ 'a list ⇒ 'a list\" where\n  \"nvr_acc [] acc = acc\" |\n  \"nvr_acc (x # xs) acc = nvr_acc xs (x # acc)\"","category":"accumulator","difficulty":"hard","required_mechanism":"induction_with_generalization","baseline":"fresh_recursive_constant","fixture_kind":"novel_problem","dependency_depth":"3"}
{"id":"novel_02_tree_mirror_inorder","goal":"nvt_inorder (nvt_mirror t) = rev (nvt_inorder t)","preamble":"datatype 'a nvt_tree = NVTLeaf | NVTNode \"'a nvt_tree\" 'a \"'a nvt_tree\"\n\nfun nvt_mirror :: \"'a nvt_tree ⇒ 'a nvt_tree\" where\n  \"nvt_mirror NVTLeaf = NVTLeaf\" |\n  \"nvt_mirror (NVTNode l x r) = NVTNode (nvt_mirror r) x (nvt_mirror l)\"\n\nfun nvt_inorder :: \"'a nvt_tree ⇒ 'a list\" where\n  \"nvt_inorder NVTLeaf = []\" |\n  \"nvt_inorder (NVTNode l x r) = nvt_inorder l @ [x] @ nvt_inorder r\"","category":"tree","difficulty":"very_hard","required_mechanism":"tree_induction_and_rewrite_chain","baseline":"fresh_datatype_and_functions","fixture_kind":"novel_problem","dependency_depth":"4"}
{"id":"novel_03_tree_mirror_involution","goal":"nvt_mirror (nvt_mirror t) = t","preamble":"datatype 'a nvt_tree = NVTLeaf | NVTNode \"'a nvt_tree\" 'a \"'a nvt_tree\"\n\nfun nvt_mirror :: \"'a nvt_tree ⇒ 'a nvt_tree\" where\n  \"nvt_mirror NVTLeaf = NVTLeaf\" |\n  \"nvt_mirror (NVTNode l x r) = NVTNode (nvt_mirror r) x (nvt_mirror l)\"","category":"tree","difficulty":"hard","required_mechanism":"multi_hypothesis_tree_induction","baseline":"fresh_datatype_and_function","fixture_kind":"novel_problem","dependency_depth":"3"}
{"id":"novel_04_compiler_correctness","goal":"nvc_exec (nvc_compile e @ code) stack = nvc_exec code (nvc_eval e # stack)","preamble":"datatype nvc_expr = NVCConst nat | NVCPlus nvc_expr nvc_expr\ndatatype nvc_instr = NVCPush nat | NVCAdd\n\nfun nvc_eval :: \"nvc_expr ⇒ nat\" where\n  \"nvc_eval (NVCConst n) = n\" |\n  \"nvc_eval (NVCPlus a b) = nvc_eval a + nvc_eval b\"\n\nfun nvc_exec :: \"nvc_instr list ⇒ nat list ⇒ nat list\" where\n  \"nvc_exec [] stack = stack\" |\n  \"nvc_exec (NVCPush n # code) stack = nvc_exec code (n # stack)\" |\n  \"nvc_exec (NVCAdd # code) [] = nvc_exec code [0]\" |\n  \"nvc_exec (NVCAdd # code) [x] = nvc_exec code [x]\" |\n  \"nvc_exec (NVCAdd # code) (x # y # stack) = nvc_exec code ((y + x) # stack)\"\n\nfun nvc_compile :: \"nvc_expr ⇒ nvc_instr list\" where\n  \"nvc_compile (NVCConst n) = [NVCPush n]\" |\n  \"nvc_compile (NVCPlus a b) = nvc_compile a @ nvc_compile b @ [NVCAdd]\"","category":"compiler","difficulty":"very_hard","required_mechanism":"induction_with_two_ih_instantiations","baseline":"fresh_abstract_machine","fixture_kind":"novel_problem","dependency_depth":"5"}
{"id":"novel_05_substitution","goal":"nvs_eval env (nvs_subst v replacement e) = nvs_eval (env(v := nvs_eval env replacement)) e","preamble":"datatype nvs_expr = NVSConst nat | NVSVar nat | NVSAdd nvs_expr nvs_expr\n\nfun nvs_eval :: \"(nat ⇒ nat) ⇒ nvs_expr ⇒ nat\" where\n  \"nvs_eval env (NVSConst n) = n\" |\n  \"nvs_eval env (NVSVar x) = env x\" |\n  \"nvs_eval env (NVSAdd a b) = nvs_eval env a + nvs_eval env b\"\n\nfun nvs_subst :: \"nat ⇒ nvs_expr ⇒ nvs_expr ⇒ nvs_expr\" where\n  \"nvs_subst v r (NVSConst n) = NVSConst n\" |\n  \"nvs_subst v r (NVSVar x) = (if x = v then r else NVSVar x)\" |\n  \"nvs_subst v r (NVSAdd a b) = NVSAdd (nvs_subst v r a) (nvs_subst v r b)\"","category":"semantics","difficulty":"very_hard","required_mechanism":"structural_induction_with_case_split","baseline":"fresh_syntax_and_semantics","fixture_kind":"novel_problem","dependency_depth":"4"}
{"id":"novel_06_flat_map_associativity","goal":"nvb_bind g (nvb_bind f xs) = nvb_bind (λx. nvb_bind g (f x)) xs","preamble":"fun nvb_bind :: \"('a ⇒ 'b list) ⇒ 'a list ⇒ 'b list\" where\n  \"nvb_bind f [] = []\" |\n  \"nvb_bind f (x # xs) = f x @ nvb_bind f xs\"","category":"higher_order_lists","difficulty":"very_hard","required_mechanism":"helper_lemma_invention_for_append","baseline":"fresh_higher_order_recursion","fixture_kind":"novel_problem","dependency_depth":"5"}
{"id":"novel_07_fold_fusion","goal":"(⋀x acc. h (nvf_step x acc) = nvg_step x (h acc)) ⟹ h (nvf_fold nvf_step xs z) = nvf_fold nvg_step xs (h z)","preamble":"fun nvf_fold :: \"('a ⇒ 'b ⇒ 'b) ⇒ 'a list ⇒ 'b ⇒ 'b\" where\n  \"nvf_fold step [] z = z\" |\n  \"nvf_fold step (x # xs) z = step x (nvf_fold step xs z)\"","category":"higher_order_algebra","difficulty":"very_hard","required_mechanism":"quantified_premise_and_induction","baseline":"fresh_fold_operator","fixture_kind":"novel_problem","dependency_depth":"4"}
{"id":"novel_08_positional_append","goal":"nvd_value (xs @ ys) = nvd_value xs + 2 ^ length xs * nvd_value ys","preamble":"fun nvd_value :: \"nat list ⇒ nat\" where\n  \"nvd_value [] = 0\" |\n  \"nvd_value (x # xs) = x + 2 * nvd_value xs\"","category":"algebraic_lists","difficulty":"very_hard","required_mechanism":"induction_plus_semiring_normalization","baseline":"fresh_recursive_numeric_function","fixture_kind":"novel_problem","dependency_depth":"4"}
{"id":"novel_09_partition_multiset","goal":"mset (fst (nvp_split p xs) @ snd (nvp_split p xs)) = mset xs","preamble":"fun nvp_split :: \"('a ⇒ bool) ⇒ 'a list ⇒ ('a list × 'a list)\" where\n  \"nvp_split p [] = ([], [])\" |\n  \"nvp_split p (x # xs) = (if p x then (x # fst (nvp_split p xs), snd (nvp_split p xs)) else (fst (nvp_split p xs), x # snd (nvp_split p xs)))\"","imports":["HOL-Library.Multiset"],"category":"data_refinement","difficulty":"very_hard","required_mechanism":"induction_case_split_and_multiset_reasoning","baseline":"fresh_partition_function","fixture_kind":"novel_problem","dependency_depth":"5"}
{"id":"novel_10_lookup_after_put","goal":"nvl_lookup k (nvl_put k v env) = Some v","preamble":"fun nvl_lookup :: \"'k ⇒ ('k × 'v) list ⇒ 'v option\" where\n  \"nvl_lookup k [] = None\" |\n  \"nvl_lookup k ((j, v) # env) = (if k = j then Some v else nvl_lookup k env)\"\n\nfun nvl_put :: \"'k ⇒ 'v ⇒ ('k × 'v) list ⇒ ('k × 'v) list\" where\n  \"nvl_put k v [] = [(k, v)]\" |\n  \"nvl_put k v ((j, w) # env) = (if k = j then (k, v) # env else (j, w) # nvl_put k v env)\"","category":"finite_maps","difficulty":"hard","required_mechanism":"induction_with_equality_split","baseline":"fresh_lookup_update_pair","fixture_kind":"novel_problem","dependency_depth":"3"}
{"id":"novel_11_other_key_preserved","goal":"k ≠ j ⟹ nvl_lookup k (nvl_put j v env) = nvl_lookup k env","preamble":"fun nvl_lookup :: \"'k ⇒ ('k × 'v) list ⇒ 'v option\" where\n  \"nvl_lookup k [] = None\" |\n  \"nvl_lookup k ((j, v) # env) = (if k = j then Some v else nvl_lookup k env)\"\n\nfun nvl_put :: \"'k ⇒ 'v ⇒ ('k × 'v) list ⇒ ('k × 'v) list\" where\n  \"nvl_put k v [] = [(k, v)]\" |\n  \"nvl_put k v ((j, w) # env) = (if k = j then (k, v) # env else (j, w) # nvl_put k v env)\"","category":"finite_maps","difficulty":"very_hard","required_mechanism":"induction_with_two_key_relations","baseline":"fresh_lookup_update_pair","fixture_kind":"novel_problem","dependency_depth":"4"}
{"id":"novel_12_tree_map_flatten","goal":"nvm_flatten (nvm_map f t) = map f (nvm_flatten t)","preamble":"datatype 'a nvm_tree = NVMLeaf 'a | NVMFork \"'a nvm_tree\" \"'a nvm_tree\"\n\nfun nvm_map :: \"('a ⇒ 'b) ⇒ 'a nvm_tree ⇒ 'b nvm_tree\" where\n  \"nvm_map f (NVMLeaf x) = NVMLeaf (f x)\" |\n  \"nvm_map f (NVMFork l r) = NVMFork (nvm_map f l) (nvm_map f r)\"\n\nfun nvm_flatten :: \"'a nvm_tree ⇒ 'a list\" where\n  \"nvm_flatten (NVMLeaf x) = [x]\" |\n  \"nvm_flatten (NVMFork l r) = nvm_flatten l @ nvm_flatten r\"","category":"tree_homomorphism","difficulty":"hard","required_mechanism":"tree_induction_with_two_hypotheses","baseline":"fresh_datatype_and_homomorphisms","fixture_kind":"novel_problem","dependency_depth":"3"}
{"id":"novel_13_accumulating_scan","goal":"nvscan acc (xs @ ys) = butlast (nvscan acc xs) @ nvscan (acc + sum_list xs) ys","preamble":"fun nvscan :: \"nat ⇒ nat list ⇒ nat list\" where\n  \"nvscan acc [] = [acc]\" |\n  \"nvscan acc (x # xs) = acc # nvscan (acc + x) xs\"","category":"accumulator","difficulty":"very_hard","required_mechanism":"generalized_induction_and_arithmetic_reassociation","baseline":"fresh_state_threading_function","fixture_kind":"novel_problem","dependency_depth":"5"}
{"id":"novel_14_state_machine_composition","goal":"nvrun (events @ more) state = nvrun more (nvrun events state)","preamble":"datatype nvevent = NVInc nat | NVDec nat\n\nfun nvstep :: \"nvevent ⇒ nat ⇒ nat\" where\n  \"nvstep (NVInc n) state = state + n\" |\n  \"nvstep (NVDec n) state = state - n\"\n\nfun nvrun :: \"nvevent list ⇒ nat ⇒ nat\" where\n  \"nvrun [] state = state\" |\n  \"nvrun (event # events) state = nvrun events (nvstep event state)\"","category":"state_machine","difficulty":"hard","required_mechanism":"induction_with_state_generalization","baseline":"fresh_transition_system","fixture_kind":"novel_problem","dependency_depth":"3"}
{"id":"novel_15_nested_flatten_map","goal":"nvflat (nvmap_rows f rows) = map f (nvflat rows)","preamble":"fun nvflat :: \"'a list list ⇒ 'a list\" where\n  \"nvflat [] = []\" |\n  \"nvflat (row # rows) = row @ nvflat rows\"\n\nfun nvmap_rows :: \"('a ⇒ 'b) ⇒ 'a list list ⇒ 'b list list\" where\n  \"nvmap_rows f [] = []\" |\n  \"nvmap_rows f (row # rows) = map f row # nvmap_rows f rows\"","category":"nested_structures","difficulty":"hard","required_mechanism":"induction_and_homomorphism_rewrite","baseline":"fresh_nested_recursors","fixture_kind":"novel_problem","dependency_depth":"3"}
